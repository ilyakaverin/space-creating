{
  "name": "space-creating",
  "version": "3.0.0",
  "description": "landing page",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "format": "biome format --write ./src",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check ./src",
    "preinstall": "npx only-allow pnpm"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyakaverin/space-creating.git"
  },
  "author": "ilya kaverin",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ilyakaverin/space-creating/issues"
  },
  "homepage": "https://github.com/ilyakaverin/space-creating#readme",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "svelte": "^5.34.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.3.3",
    "vite": "^5.4.19"
  }
}
