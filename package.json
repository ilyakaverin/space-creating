  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@vercel/functions": "^3.9.9",
