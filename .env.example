# Copy to .env.local and adjust. `pnpm dev`, `pnpm build` and `pnpm start` read it.
#
# On Vercel none of this is needed: the Neon integration sets DATABASE_URL,
# and the site's address comes from Vercel's own variables. To develop against
# the same database, link the project and pull its variables instead:
#   pnpm dlx vercel link
#   pnpm dlx vercel env pull .env.local

# Postgres connection string. With Neon, the pooled one (host name ends in -pooler).
# POSTGRES_URL is read if this is unset.
DATABASE_URL=postgresql://user:password@localhost:5432/passkeys

# Where the site runs. WebAuthn needs https, except on localhost.
# Several origins may be listed, comma-separated. `pnpm dev` defaults to
# http://localhost:3000; on Vercel, production uses the production domain and
# a preview its branch URL. Required when self-hosting.
# PASSKEY_ORIGIN=https://example.com

# Domain passkeys are bound to. Defaults to the origin's hostname.
# PASSKEY_RP_ID=example.com
# Only if PASSKEY_RP_ID is not the page's hostname (used for the Signal API).
# NEXT_PUBLIC_ values are written into the code at build time: rebuild after changing it.
# NEXT_PUBLIC_PASSKEY_RP_ID=example.com

# Shown by some authenticators next to the passkey.
# PASSKEY_RP_NAME=creating space

# How long a session lasts without activity, in days (1–365).
# SESSION_TTL_DAYS=30

# Where rate limiting reads the client's IP address. By default the rightmost
# X-Forwarded-For entry: right on Vercel, and behind one reverse proxy that
# appends to it when self-hosting.
# PASSKEY_XFF_DEPTH=1          # number of proxies in front of the app
# PASSKEY_CLIENT_IP_HEADER=x-real-ip   # or a header your proxy sets instead
