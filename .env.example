# Copy to .env and adjust. `pnpm dev`, `pnpm build` and `pnpm start` read .env.

# Frontend: use the built-in backend instead of keeping passkeys in the browser.
# Leave unset for the browser-only mode (then nothing below is needed).
# NEXT_PUBLIC_ values are written into the code at build time: rebuild after changing them.
NEXT_PUBLIC_PASSKEY_API_URL=/api/passkey

# Where the site runs. WebAuthn needs https, except on localhost.
# Several origins may be listed, comma-separated. Required in production;
# `pnpm dev` defaults to http://localhost:3000, so only uncomment it with the
# real value.
# PASSKEY_ORIGIN=https://example.com

# Domain passkeys are bound to. Defaults to the origin's hostname.
# PASSKEY_RP_ID=example.com
# Only if PASSKEY_RP_ID is not the page's hostname (used for the Signal API):
# NEXT_PUBLIC_PASSKEY_RP_ID=example.com

# Shown by some authenticators next to the passkey.
# PASSKEY_RP_NAME=creating space

# SQLite file; the folder is created if missing.
# DATABASE_PATH=data/passkeys.sqlite

# How long a session lasts without activity, in days (1–365).
# SESSION_TTL_DAYS=30

# Where rate limiting reads the client's IP address. By default the rightmost
# X-Forwarded-For entry, which suits one reverse proxy that appends to it.
# PASSKEY_XFF_DEPTH=1          # number of proxies in front of the app
# PASSKEY_CLIENT_IP_HEADER=x-real-ip   # or a header your proxy sets instead
